# Copy to .env (or set these in your hosting panel)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=greenhills.com.kw,www.greenhills.com.kw
DJANGO_CSRF_TRUSTED_ORIGINS=https://greenhills.com.kw,https://www.greenhills.com.kw

# Optional: email the events team for every new booking
BOOKING_NOTIFY_EMAILS=events@greenhills.com.kw
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Green Hills Website <no-reply@greenhills.com.kw>
